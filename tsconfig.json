{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@aao/substrate-contracts": ["packages/substrate-contracts/src/index.ts"],
      "@aao/substrate-spikes": ["packages/substrate-spikes/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "eslint.config.mjs", "vitest.config.ts"]
}
