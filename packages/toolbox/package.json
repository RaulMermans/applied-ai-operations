{
  "name": "@aao/toolbox",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "The AAO Toolbox: curated, versioned, provider-neutral Tool definitions with discovery metadata. Tools execute only through the canonical Tool Runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.20.0 <21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "smoke:sprint21": "node smoke/sprint21.mjs"
  },
  "dependencies": {
    "@aao/contracts": "workspace:*",
    "@aao/framework": "workspace:*",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@aao/evaluation": "workspace:*",
    "@aao/observability": "workspace:*",
    "@aao/tool-runtime": "workspace:*"
  }
}
