{
  "name": "@aao/model-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vercel-ai": {
      "types": "./src/adapters/vercel-ai.ts",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./vercel-ai/conformance": {
      "types": "./src/adapters/vercel-ai-conformance.ts",
      "default": "./dist/adapters/vercel-ai-conformance.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aao/adapters": "workspace:*",
    "@aao/contracts": "workspace:*",
    "@aao/runtime": "workspace:*",
    "ai": "^7.0.107",
    "ajv": "^8.20.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@aao/workflow-dsl": "workspace:*"
  }
}
