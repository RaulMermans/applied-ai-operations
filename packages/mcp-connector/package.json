{
  "name": "@aao/mcp-connector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "default": "./dist/conformance.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@aao/adapters": "workspace:*",
    "@aao/contracts": "workspace:*",
    "@aao/tool-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@aao/governance": "workspace:*",
    "@aao/authorization": "workspace:*",
    "@aao/runtime": "workspace:*",
    "@aao/workflow-dsl": "workspace:*"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "conformance/server.mjs"
  ]
}
