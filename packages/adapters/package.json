{
  "name": "@aao/adapters",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "The vendor-free AAO adapter and portability contract: manifests, kinds, capabilities, compatibility, and the conformance vocabulary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aao/contracts": "workspace:*",
    "zod": "^3.24.3"
  }
}
