{
  "name": "@aao/example-document-intelligence",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Sprint 23 proof application: bounded document ingestion, page/span provenance, and evidence-anchored extraction as a governed AAO Workflow.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.20.0 <21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proof": "node dist/demo/run.js",
    "smoke:sprint23": "node smoke/sprint23.mjs"
  },
  "dependencies": {
    "@aao/framework": "workspace:*",
    "@aao/integration-documents": "workspace:*"
  },
  "devDependencies": {
    "@aao/adapters": "workspace:*",
    "@aao/contracts": "workspace:*",
    "@aao/evaluation": "workspace:*",
    "@aao/model-runtime": "workspace:*",
    "@aao/observability": "workspace:*",
    "ai": "^7.0.107"
  }
}
