{
  "name": "applied-ai-operations",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.20.0 <21.0.0"
  },
  "scripts": {
    "dev:control-plane": "tsx watch apps/control-plane/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present run build",
    "build:framework": "pnpm --silent --filter \"@aao/framework...\" run build 1>&2",
    "aao": "pnpm run --silent build:framework && node packages/framework/dist/cli/main.js",
    "eval:ci": "pnpm run --silent build:framework && node packages/framework/dist/cli/main.js eval ci",
    "eval:adapters": "pnpm run --silent build:framework && node packages/framework/dist/cli/main.js eval adapters",
    "eval:baseline:propose": "pnpm run --silent build:framework && node packages/framework/dist/cli/main.js eval baseline propose",
    "proof:company-research": "pnpm --silent --filter \"@aao/example-company-research...\" run build 1>&2 && node examples/company-research/dist/demo/run.js",
    "proof:document-intelligence": "pnpm --silent --filter \"@aao/example-document-intelligence...\" run build 1>&2 && node examples/document-intelligence/dist/demo/run.js",
    "proof:operational-request": "pnpm --silent --filter \"@aao/example-operational-request...\" run build 1>&2 && node examples/operational-request/dist/demo/run.js",
    "proof:company-portability": "pnpm --silent --filter \"@aao/example-company-portability...\" run build 1>&2 && node examples/company-portability/dist/demo/run.js",
    "proof:capability-packs": "pnpm --silent --filter \"@aao/example-capability-packs...\" run build 1>&2 && node examples/capability-packs/dist/demo/run.js",
    "proof:security-hardening": "pnpm --silent --filter \"@aao/example-security-hardening...\" run build 1>&2 && node examples/security-hardening/dist/demo/run.js",
    "proof:operator-inspection": "pnpm --silent --filter \"@aao/example-operator-inspection...\" run build 1>&2 && node examples/operator-inspection/dist/demo/run.js",
    "benchmark:local-v1": "pnpm --filter @aao/benchmarks-local-v1 benchmark",
    "release:verify:local-v1": "node scripts/release-verify-local-v1.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && node packages/framework/dist/cli/main.js eval ci && node packages/framework/dist/cli/main.js eval adapters"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.3"
  }
}
