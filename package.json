{
  "name": "applied-ai-operations",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.20.0 <21.0.0"
  },
  "scripts": {
    "dev:control-plane": "tsx watch apps/control-plane/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.3"
  }
}
