# AAO Control Plane and Worker configuration (see packages/config).
# All values below have local defaults; nothing here is required to run
# `pnpm dev:control-plane` or `pnpm dev:worker`.

# development | test | production
AAO_ENV=development

# debug | info | warn | error
AAO_LOG_LEVEL=info

# Control Plane HTTP binding
AAO_CONTROL_PLANE_HOST=127.0.0.1
AAO_CONTROL_PLANE_PORT=4000

# Worker process identity
AAO_WORKER_ID=aao-worker-local
